{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "AllowedHosts": "*",
  "Cloudinary": {
    "CloudName": "your-cloud-name",
    "ApiKey": "your-api-key",
    "ApiSecret": "your-api-secret"
  },
  "Kestrel": {
    "Limits": {
      "MaxRequestBodySize": 1073741824
    }
  },
  "Jwt": {
    "Issuer": "https://your-domain:1000",
    "Audience": "https://your-domain:1000",
    "SecretKey": "your-super-secure-secret-key-with-at-least-32-bytes-length-123456789"
  },
  "Brevo": {
    "ApiKey": "xkeysib-your-brevo-api-key",
    "SenderEmail": "sender@yourdomain.com",
    "SenderName": "Your Company Name"
  }
}
